[sub_resource type="CSharpScript" id="CSharpScript_v0iea"]
script/source = "using Godot;
using System;

public partial class Player : CharacterBody2D
{
	public float Speed = 150.0f;
	public float health = 100.0f;

	// Reference to the AnimatedSprite2D node
	private AnimatedSprite2D _animatedSprite;

	public override void _Ready()
	{
		// Fetch the node when the player enters the scene tree
		_animatedSprite = GetNode<AnimatedSprite2D>(\"AnimatedSprite2D\");
	}
	
	
	private float _footstepTimer = 0.0f;
	private float _footstepInterval = 0.35f;

	public override void _PhysicsProcess(double delta)
	{
		Vector2 velocity = Velocity;

		// Get the input direction for all 4 directions (X and Y axes)
		Vector2 direction = Input.GetVector(\"ui_left\", \"ui_right\", \"ui_up\", \"ui_down\");
		
		

		// Handle movement, animations, and flipping
		if (direction != Vector2.Zero)
		{
			velocity = direction * Speed;
			_animatedSprite.Play(\"walk\");

			_footstepTimer -= (float)delta;
			
			if (_footstepTimer <= 0.0f)
			{
			GetNode<AudioStreamPlayer2D>(\"PlayerFootstep\").Play();
			_footstepTimer = _footstepInterval;
			}
			// Flip horizontally only if there is horizontal movement
			if (direction.X != 0)
			{
				// true if moving left (negative X), false if moving right (positive X)
				_animatedSprite.FlipH = direction.X < 0;
			}
		}
		else
		{
			velocity.X = Mathf.MoveToward(Velocity.X, 0, Speed);
			velocity.Y = Mathf.MoveToward(Velocity.Y, 0, Speed);
			_animatedSprite.Play(\"idle\");
			
			_footstepTimer = 0.0f;
		}

		Velocity = velocity;
		MoveAndSlide();
	}
}
"

